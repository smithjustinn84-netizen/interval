    <string name="program_daily_name">Daily 100 swings + 10 get-ups</string>
    <string name="program_daily_summary">10 minutes of swings on the minute, then 5 get-ups a side · 5 days a week for 6 weeks</string>
    <string name="program_ladders_name">Press ladders 1-2-3</string>
    <string name="program_ladders_summary">Ladders of 1, 2 and 3 presses a side, 3 to 5 of them, with swings or snatches · 3 days a week for 8 weeks</string>
    <string name="program_clean_press_name">Clean and press EMOM</string>
    <string name="program_clean_press_summary">10 minutes of 3 cleans, then 10 of 3 presses, alternating sides · 3 days a week for 4 weeks</string>
    <string name="program_goblet_row_name">Goblet squat and row</string>
    <string name="program_goblet_row_summary">3 sets of 10 of each · 2 days a week for 4 weeks</string>
    <string name="program_easy_strength_name">Easy Strength</string>
    <string name="program_easy_strength_summary">Press, row and goblet squat 2 × 5, swings and a get-up a side, light and easy · 5 days a week for 8 weeks</string>
    <string name="program_abf_name">Armor Building Formula</string>
    <string name="program_abf_summary">20 minutes of the Armor Building Complex on the minute, two days in three; press ladders of 2-3-5 and swings between · 3 days a week for 6 weeks</string>
    <string name="program_ten_thousand_name">10,000 swings</string>
    <string name="program_ten_thousand_summary">500 swings a day in ladders of 10-15-25-50, with press or goblet squat ladders of 1-2-3 · 5 days a week for 4 weeks</string>
    <string name="program_countdown_name">Swing and squat countdown</string>
    <string name="program_countdown_summary">Goblet squats from 10 down to 1 and 10 sets of 15 swings, after the Humane Burpee · 3 days a week for 4 weeks</string>
    <string name="program_simple_sinister_name">Simple &amp; Sinister</string>
    <string name="program_simple_sinister_summary">100 one-arm swings in sets of 10, then 10 get-ups, a side at a time · 5 days a week for 12 weeks</string>
    <string name="program_program_minimum_name">Program Minimum</string>
    <string name="program_program_minimum_summary">12 minutes of swings on the minute one day, 5 get-ups a side the next, after Enter the Kettlebell · 4 days a week for 4 weeks</string>
    <string name="program_rite_of_passage_name">Rite of Passage</string>
    <string name="program_rite_of_passage_summary">5 clean and press ladders: to 5 on the heavy day, 3 on the light and 4 on the medium, then snatches or swings. Build to it from 3 ladders of 1-2-3 · 3 days a week for 12 weeks</string>
    <string name="program_iron_cardio_name">Iron Cardio</string>
    <string name="program_iron_cardio_summary">A clean, a press and a squat as one rep, on the minute for 20 or 30 minutes, with 100 swings on the shorter day · 3 days a week for 6 weeks</string>
    <string name="program_snatch_test_name">Snatch test prep</string>
    <string name="program_snatch_test_summary">Snatches on the minute, alternating hands, and a day at the test's pace of 100 in 5 minutes · 3 days a week for 6 weeks</string>
    <string name="program_long_cycle_name">Long cycle EMOM</string>
    <string name="program_long_cycle_summary">Long cycles on the minute, alternating sides, with a day of jerks and snatches between · 3 days a week for 6 weeks</string>
    <string name="program_grappler_strength_name">Strength for the mat</string>
    <string name="program_grappler_strength_summary">Double front squats or deadlifts, rows, presses, get-ups and windmills, heavy and low in reps · 2 days a week for 8 weeks</string>
    <string name="program_rounds_name">Round conditioning</string>
    <string name="program_rounds_summary">Four six-minute rounds of swings, snatches, pulls, squats and lunges on the minute, like rounds on the mat · 2 days a week for 6 weeks</string>
    <string name="program_grip_pull_name">Grip and pull</string>
    <string name="program_grip_pull_summary">Rows, high pulls, cleans and one-arm swings a side, for grips that hold · 2 days a week for 6 weeks</string>
    <string name="program_shoulder_armor_name">Shoulder armor</string>
    <string name="program_shoulder_armor_summary">Halos, get-ups, windmills and bottoms-up presses, for shoulders that hold up under frames and locks · 3 days a week for 6 weeks</string>
    <string name="program_foundations_name">Kettlebell foundations</string>
    <string name="program_foundations_summary">Deadlifts, goblet squats and halos one day; swings and get-ups the next. Learn each lift light · 3 days a week for 4 weeks</string>
    <string name="program_first_hundred_name">Your first 100 swings</string>
    <string name="program_first_hundred_summary">Deadlifts to groove the hinge, then two-hand swings on the minute for 10 minutes, from 5 a minute up to 10 · 3 days a week for 4 weeks</string>
    <string name="program_beginner_full_body_name">Full body for beginners</string>
    <string name="program_beginner_full_body_summary">Goblet squats, presses and rows one day; deadlifts, cleans and swings the other, a few sets of each · 2 days a week for 6 weeks</string>
    <string name="program_get_up_practice_name">Get-up practice</string>
    <string name="program_get_up_practice_summary">5 get-ups a side, slow, with halos and goblet squats to open the shoulders and hips · 3 days a week for 4 weeks</string>
    <string name="programs_beginner">Getting started</string>
    <string name="program_bodyweight_basics_name">Bodyweight basics</string>
    <string name="program_bodyweight_basics_summary">Push-ups, squats, rows and a plank one day; lunges, dips, bridges and side planks the next · 3 days a week for 6 weeks</string>
    <string name="program_bodyweight_emom_name">Bodyweight EMOM</string>
    <string name="program_bodyweight_emom_summary">Burpees and air squats, or push-ups and mountain climbers, on the minute for 10 minutes each · 3 days a week for 4 weeks</string>
    <string name="program_bells_bodyweight_name">Bells and bodyweight</string>
    <string name="program_bells_bodyweight_summary">Swings with push-ups and goblet squats; cleans with pull-ups, press ladders and a hollow hold · 3 days a week for 6 weeks</string>
    <string name="program_bands_bells_name">Bands and bells</string>
    <string name="program_bands_bells_summary">Presses and rows with band pull-aparts and face pulls; squats and deadlifts with Pallof presses and banded bridges · 2 days a week for 6 weeks</string>
    <string name="program_core_mat_name">Core on the mat</string>
    <string name="program_core_mat_summary">The hundred, roll-ups, single-leg stretches and swimming, then windmills and get-ups with a bell · 2 days a week for 6 weeks</string>
    <string name="program_olympic_foundations_name">Olympic foundations</string>
    <string name="program_olympic_foundations_summary">Power snatches, overhead squats and snatch pulls; power cleans, push presses and clean pulls; then the full snatch and clean and jerk, with a squat each day · 3 days a week for 8 weeks</string>
    <string name="program_five_by_five_name">Barbell 5×5</string>
    <string name="program_five_by_five_summary">Back squats every day, with bench presses and rows, or overhead presses and a set of deadlifts · 3 days a week for 12 weeks</string>
