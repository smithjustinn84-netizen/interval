# OS
.DS_Store
._*

# Kotlin Toolchain / Amper build output
build/
.amper/
.kotlin/

# Android
*.apk
*.aab
local.properties
captures/
.cxx/
*.jks
*.keystore

# Xcode: keep the project file, shared schemes and shared workspace settings (scheme autocreation
# is off there, so Xcode doesn't add a duplicate of the app scheme); ignore per-user state
**/module.xcodeproj/*
!**/module.xcodeproj/project.pbxproj
!**/module.xcodeproj/xcshareddata/
!**/module.xcodeproj/project.xcworkspace/
xcuserdata/
DerivedData/

# IDEs
.idea/
*.iml
.fleet/
.vscode/

# Logs and runtime files
*.log
*.hprof
hs_err_pid*

# Secrets
.env
.env.*
!.env.example
