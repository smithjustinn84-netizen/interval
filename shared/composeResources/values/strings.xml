<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-facing string. ViewModels expose typed data; screens resolve the words here with
  stringResource / pluralStringResource, and the cue players with getString.
  Keys: <area>_<element>; `_cd` marks a content description, `_hint` a subtitle.
-->
<resources>
    <string name="app_name">Interval</string>

    <!-- Joins two parts of a line: "Tabata · 20s on · 10s off · ×8". -->
    <string name="common_joined">%1$s · %2$s</string>

    <!-- Navigation -->
    <string name="nav_timer">Timer</string>
    <string name="nav_lift">Lift</string>
    <string name="nav_history">History</string>

    <!-- About -->
    <string name="about_title">About</string>
    <!-- "Version 0.1.0" -->
    <string name="about_version">Version %1$s</string>
    <!-- In place of the version when the build carries none, as a desktop run from source doesn't -->
    <string name="about_version_unknown">Development build</string>
    <string name="about_tagline">A timer for work and rest intervals, with cues loud enough for the gym.</string>
    <string name="about_made_by">Made by Justin Smith</string>
    <string name="about_licenses">Open-source licenses</string>
    <string name="about_licenses_hint">The fonts and libraries Interval is built with</string>

    <!-- Licenses -->
    <string name="licenses_title">Licenses</string>
    <string name="licenses_fonts">Fonts</string>
    <string name="licenses_libraries">Libraries</string>
    <!-- The action of a credit row, which opens or closes the license text under it -->
    <string name="licenses_show">Show license</string>
    <string name="licenses_hide">Hide license</string>
    <string name="license_ofl">SIL Open Font License 1.1</string>
    <string name="license_apache">Apache License 2.0</string>
    <string name="license_mit">MIT License</string>
    <string name="license_public_domain">Public domain</string>

</resources>
