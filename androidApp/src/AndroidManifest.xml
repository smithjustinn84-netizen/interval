<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptic cues on phase changes. A normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- The running workout's foreground service (WorkoutService, in shared) and its ongoing notification.
         Special use: a workout outlasts a short service, and the health type wants sensor permissions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13+: asked for at runtime when the first workout starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the CPU up while the workout runs with the screen off, so the cues play on time. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- The plan's reminders are alarms, which a reboot drops: PlanReminderReceiver sets them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 11+ package visibility: lets TextToSpeech find the device's speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>

    <!-- Backup and device transfer carry history, presets, the plan, settings and Lift's data: the rules
         in res/xml name what stays behind. -->
    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Interval.Starting">
        <activity
                android:exported="true"
                android:name=".MainActivity"
                android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
                android:exported="false"
                android:foregroundServiceType="specialUse"
                android:name="dev.justinsmith.interval.platform.WorkoutService">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps an interval-training timer the user started counting, and shows its clock, phase and round with Pause and End, while the app is off screen."/>
        </service>

        <!-- Lift's rest between sets, kept counting with the screen off (RestService, in bells-data). -->
        <service
                android:exported="false"
                android:foregroundServiceType="specialUse"
                android:name="dev.justinsmith.bells.platform.RestService">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps a rest between sets the user started counting, and shows the time left, while the app is off screen, so its end is heard."/>
        </service>

        <!-- Exported files are offered to the share sheet through this provider (paths in res/xml/file_paths.xml). -->
        <provider
                android:authorities="dev.justinsmith.interval.files"
                android:exported="false"
                android:grantUriPermissions="true"
                android:name="androidx.core.content.FileProvider">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <!-- The plan's reminders: each alarm lands here, as do the reboots and clock changes they are set again after. -->
        <receiver
                android:exported="false"
                android:name="dev.justinsmith.interval.platform.PlanReminderReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
