<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Group Bells and Interval share their workouts through (AppGroupSiblingFeed in core-sync).
  It only takes effect once the app is signed: set DEVELOPMENT_TEAM, the same team for both apps.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.justinsmith</string>
	</array>
</dict>
</plist>
