<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so the adaptive icon is the only one: no legacy PNGs. The foreground is the rendered bell,
     tools/render_icon_3d.py's, a PNG a density; the monochrome layer is the themed icon Android 13+ tints to
     match the wallpaper, the flat mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground_3d"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
