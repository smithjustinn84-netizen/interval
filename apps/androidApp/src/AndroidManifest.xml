<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptic cues on phase changes. A normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- The running workout's foreground service (WorkoutService, in shared) and its ongoing notification.
         Special use: a workout outlasts a short service, and the health type wants sensor permissions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13+: asked for at runtime when the first workout starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 16+: the workout's and the rest's notifications are Live Updates, a chip in the status bar and a
         bar on the lock screen. A normal permission: granted at install, no prompt; the user can turn it off. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- Keeps the CPU up while the workout runs with the screen off, so the cues play on time. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- The plan's reminders are alarms, which a reboot drops: PlanReminderReceiver sets them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Health Connect (HealthConnectStore, in core-platform): finished workouts and Lift sessions written there
         as exercise sessions with their calories, once the user connects it in Settings. Write only, never read.
         Health Connect asks the user through its own sheet; Play's Health apps declaration must list both. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE"/>
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED"/>

    <!-- Android 11+ package visibility: lets TextToSpeech find the device's speech engine, and the Health Connect
         client find its app on Android 13 and before (on 14 and up it is part of the system). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>

    <!-- Backup and device transfer carry history, presets, the plan, settings and Lift's data: the rules
         in res/xml name what stays behind. -->
    <application
            android:name=".IntervalApplication"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Interval.Starting">
        <activity
                android:exported="true"
                android:name=".MainActivity"
                android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>

        <!-- The launcher shortcuts' target: invisible, in a task of its own, it hands the shortcut to MainActivity
             without the task clear a static shortcut always asks for, which would end a running workout. -->
        <activity
                android:excludeFromRecents="true"
                android:exported="false"
                android:name=".ShortcutActivity"
                android:noHistory="true"
                android:taskAffinity=""
                android:theme="@android:style/Theme.NoDisplay"/>

        <!-- The privacy policy, which Health Connect opens on its own: from its permission sheet on Android 13
             and before, and from the app's entry in its settings on 14 and up (the alias, which only the
             system may start). -->
        <activity
                android:exported="true"
                android:name=".PrivacyActivity"
                android:theme="@style/Theme.Interval">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias
                android:exported="true"
                android:name="ViewPermissionUsageActivity"
                android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
                android:targetActivity=".PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <service
                android:exported="false"
                android:foregroundServiceType="specialUse"
                android:name="dev.justinsmith.interval.platform.WorkoutService">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps an interval-training timer the user started counting, and shows its clock, phase and round with Pause and End, while the app is off screen."/>
        </service>

        <!-- Lift's rest between sets, kept counting with the screen off (RestService, in lift-platform). -->
        <service
                android:exported="false"
                android:foregroundServiceType="specialUse"
                android:name="dev.justinsmith.lift.platform.RestService">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps a rest between sets the user started counting, and shows the time left, while the app is off screen, so its end is heard."/>
        </service>

        <!-- Exported files are offered to the share sheet through this provider (paths in res/xml/file_paths.xml). -->
        <provider
                android:authorities="dev.justinsmith.interval.files"
                android:exported="false"
                android:grantUriPermissions="true"
                android:name="androidx.core.content.FileProvider">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <!-- The plan's reminders: each alarm lands here, as do the reboots and clock changes they are set again after. -->
        <receiver
                android:exported="false"
                android:name="dev.justinsmith.interval.platform.PlanReminderReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
