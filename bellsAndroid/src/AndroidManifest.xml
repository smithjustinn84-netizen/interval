<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sharing workouts with Interval: only apps signed with the same key hold this, and each app's feed
      provider is readable only with it. Both apps declare it as well as use it, so the grant works
      whichever is installed first.
    -->
    <permission
            android:name="dev.justinsmith.permission.SYNC"
            android:protectionLevel="signature"/>
    <uses-permission android:name="dev.justinsmith.permission.SYNC"/>

    <!-- Android 11+ package visibility: lets Bells see Interval's feed provider and open Interval (interval://). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>

            <data android:scheme="interval"/>
        </intent>
        <provider android:authorities="dev.justinsmith.interval.feed"/>
    </queries>

    <application
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:supportsRtl="true"
            android:theme="@style/Theme.Bells">
        <!-- singleTask: opened from Interval, the app comes forward in its own task, not inside Interval's. -->
        <activity
                android:exported="true"
                android:launchMode="singleTask"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- bells://, so a row of Bells's workouts in Interval opens this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="bells"/>
            </intent-filter>
        </activity>

        <!-- Serves Bells' sessions, as a snapshot file, to Interval. -->
        <provider
                android:name="dev.justinsmith.core.sync.FeedProvider"
                android:authorities="dev.justinsmith.kettlebell.feed"
                android:exported="true"
                android:readPermission="dev.justinsmith.permission.SYNC"/>
    </application>

</manifest>
